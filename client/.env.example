# XPRTY Interview web app — client/.env
# Copy this file to client/.env (or configure these values in your hosting provider).
# VITE_ variables are embedded in the browser bundle: never add secrets here.

# Public HTTPS URL of the deployed API, including /api and without a trailing slash.
VITE_API_URL=https://api.interview.example.com/api
# Public HTTPS URL of the same deployed API for Socket.IO, without /api.
VITE_WS_URL=https://api.interview.example.com
