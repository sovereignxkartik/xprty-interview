# XPRTY Interview web app — client/.env
# Copy this file to client/.env (or configure these values in your hosting provider).
# This value is read only by Vite's local development proxy; it is never embedded
# in the browser bundle. In production, serve the client and API behind the same
# origin and proxy /api and /socket.io to the API service.
API_PROXY_TARGET=http://localhost:5000
