# XPRTY Interview web app — client/.env
# Copy this file to client/.env (or configure these values in your hosting provider).
# These are public browser settings, not secrets. A separately deployed frontend
# needs the public address of its API. Never put API keys, JWT secrets, or service
# role keys in a VITE_ variable.
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000
