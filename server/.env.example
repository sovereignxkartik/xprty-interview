# XPRTY Interview API — server/.env
# Copy this file to server/.env. Do not commit server/.env.

# Server and browser origins
NODE_ENV=production
PORT=5000
# Public URL where the web application is hosted. Multiple origins may be
# comma-separated for preview/staging deployments.
CLIENT_URL=https://interview.example.com
CORS_ORIGIN=https://interview.example.com

# Authentication — generate a unique random value (at least 32 bytes) for every
# production environment. For example: openssl rand -base64 48
JWT_SECRET=8fbfbdfe-f5ad-4ae1-ba70-8efcaa687c70

# Jitsi Meet host. meet.jit.si is for development; use an authenticated JaaS or self-hosted host in production.
JITSI_DOMAIN=meet.jit.si

# Supabase — server-only credentials. The service role key bypasses RLS, so it
# must never be sent to the client or committed to source control.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-service-role-key
# Optional: used only if SUPABASE_SERVICE_ROLE_KEY is deliberately unavailable.
SUPABASE_ANON_KEY=replace-with-your-publishable-anon-key
